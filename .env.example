# Puerto del servidor local para el bot
PORT=3008

# Nombre de la empresa o negocio
BUSINESS_NAME="Innovatech Soluciones"

# Retardo en milisegundos entre respuestas para simular escritura humana (Anti-Ban)
RESPONSE_DELAY_MS=1200

# (Opcional) API Key gratuita de Google Gemini (Google AI Studio) para respuestas con IA
# Dejar vacío si se desea usar únicamente el motor de reglas 100% gratuito sin keys
GEMINI_API_KEY=
